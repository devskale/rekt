# Polymarket API
POLYMARKET_API_URL=https://gamma-api.polymarket.com

# Server
PORT=3000

# Trading
POLL_INTERVAL_MS=10000
MAX_OPEN_TICKS=5

# Fee config (Polymarket rates)
# Category: crypto | sports | finance | politics | other
MARKET_CATEGORY=crypto
# Override taker fee rate (default: 0.07 for crypto)
# TAKER_FEE_RATE=0.07

# Late Scalp strategy tuning
SCALP_ENTRY_PRICE=0.95
SCALP_WINDOW_SECONDS=35

# Focus on BTC 5-min up/down markets (fast resolving windows)
BTC_5MIN_ONLY=true

# Demo mode (generates fake markets, no real API calls)
DEMO_MODE=false
